DATABASE_PATH=devops_assistant.db
# Optional: only needed for instant GitHub webhooks. Use a unique secret and
# put the same value in the GitHub webhook settings. Refresh works without it.
GITHUB_WEBHOOK_SECRET=
# Optional GitHub App installation token or fine-grained PAT for private repositories.
GITHUB_TOKEN=
# Optional server-side default. Users can instead connect their own key in the dashboard.
# Never put a real key in this example file or commit it to Git.
AI_PROVIDER=gemini
AI_API_KEY=
# Used only for OpenAI-compatible providers; provider keys alone do not make APIs interchangeable.
LLM_BASE_URL=
LLM_MODEL=gemini-3.5-flash-lite
